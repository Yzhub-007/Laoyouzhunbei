# Field reference only. Do not fill secrets into this file.
# Use: python security_cli.py set-secret KEY (hidden input).
# Protected values: runtime/secrets.dpapi. Legacy .env is migrated on startup.
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
LLM_TRUSTED_ORIGINS=
VISION_ENDPOINT=
VISION_API_KEY=
VISION_MODEL=
VISION_TRUSTED_ORIGINS=
CAMERA_TRUSTED_ORIGINS=
MONITOR_TRUSTED_ORIGINS=
ZJDATA_USER_SECRET=
ZJDATA_APP_SECRET=
# Loopback only by default. Private remote origins require HTTPS, verified TLS,
# explicit scheme://host:port without path, and private DNS results. Public denied.
# Remote vision also requires a non-full-frame ROI per source.
# RTSP disabled. Use a private HTTPS snapshot gateway.
# FFmpeg is optional for LOCAL VIDEO REPLAY only.
VISION_FFMPEG=
SECURITY_OBSERVATION_DAYS=7
SECURITY_EVENT_DAYS=30
SECURITY_CORRECTION_DAYS=30
